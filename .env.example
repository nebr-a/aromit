# SMTP (Microsoft 365 / Office 365) — pour l'envoi du formulaire de contact
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=info@arom.ch
SMTP_PASSWORD=ton_mot_de_passe_de_compte_OU_app_password

# Destinataire des messages reçus depuis le formulaire (par défaut info@arom.ch)
CONTACT_TO=info@arom.ch
# Adresse d'envoi (DOIT être info@arom.ch ou un alias autorisé du compte)
CONTACT_FROM=info@arom.ch

# ⚠️ Pré-requis Microsoft 365 :
# 1. SMTP AUTH doit être ACTIVÉ pour la boîte info@arom.ch
#    → Centre admin Microsoft 365 → Utilisateurs → info@arom.ch → Courrier
#    → Gérer les applications de messagerie → cocher "SMTP authentifié"
# 2. Si MFA activée sur le compte → créer un "mot de passe d'application" :
#    → https://account.microsoft.com/security → Sécurité avancée
#    → Mots de passe d'application → Créer
#    → Utiliser ce mot de passe dans SMTP_PASSWORD
