# Resend — service d'envoi d'emails transactionnels
# 1. Créer un compte gratuit sur https://resend.com (3'000 emails/mois inclus)
# 2. Ajouter le domaine arom.ch et valider via les DNS (SPF, DKIM, DMARC) :
#    Resend te donne 3 enregistrements à ajouter dans le DNS Infomaniak
# 3. Créer une API Key dans Settings → API Keys (permission "Sending access" sur arom.ch)
# 4. Coller la clé ci-dessous

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Adresse d'envoi (DOIT être sur un domaine validé chez Resend, ex: noreply@arom.ch)
CONTACT_FROM=AROM IT <noreply@arom.ch>

# Destinataire(s) — séparer par virgule pour envoyer à plusieurs adresses
CONTACT_TO=info@arom.ch

# 💡 Pour tester avant validation du domaine, tu peux temporairement utiliser :
# CONTACT_FROM=AROM IT <onboarding@resend.dev>
# (mais limité à ton adresse de connexion Resend pour le destinataire)
