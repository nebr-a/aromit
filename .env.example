# SMTP (Infomaniak) — pour l'envoi du formulaire de contact
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
SMTP_USER=info@arom.ch
SMTP_PASSWORD=ton_mot_de_passe_smtp

# Destinataire des messages reçus depuis le formulaire (par défaut info@arom.ch)
CONTACT_TO=info@arom.ch
# Adresse d'envoi (doit être autorisée sur le compte SMTP)
CONTACT_FROM=info@arom.ch
